{
  "name": "zhiheng-fastapi-frontend",
  "version": "1.10.0",
  "description": "智衡 AI 开放平台前端",
  "author": "insistence",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build:prod": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:docker": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --mode docker",
    "build:stage": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --mode staging",
    "test:plugin": "node tests/plugins/run-plugin-tests.js",
    "lint:core": "eslint --max-warnings 0 --no-error-on-unmatched-pattern eslint.config.js src/vite-env.d.ts \"src/{app,shared,modules}/**/*.{ts,tsx,vue}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/{app,shared,modules}/**/*.{ts,tsx,vue,js,json,css,scss,md}\" src/vite-env.d.ts eslint.config.js .prettierrc.json tsconfig.json package.json QUALITY.md",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/cyhja/zhiheng.git"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/g2plot": "^2.4.31",
    "@antv/infographic": "^0.2.13",
    "@element-plus/icons-vue": "2.3.2",
    "@terrastruct/d2": ">=0.1.33",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "14.1.0",
    "ant-design-vue": "^4.1.1",
    "axios": "1.19.0",
    "clipboard": "2.0.11",
    "dompurify": "^3.4.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "file-saver": "2.0.5",
    "fuse.js": "7.1.0",
    "js-beautify": "1.15.4",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.3.2",
    "katex": ">=0.16.27",
    "markstream-vue": ">=1.0.9-beta.2",
    "mermaid": ">=11.15.0",
    "node-forge": "1.4.0",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "shiki": "^3.21.0",
    "stream-diffs": ">=0.0.2",
    "stream-markdown": ">=0.0.16",
    "stream-monaco": ">=0.0.48",
    "uuid": "14.0.1",
    "vue": "3.5.26",
    "vue-cropper": "1.1.1",
    "vue-router": "4.6.4",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@vitejs/plugin-vue": "5.2.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.4.0",
    "less": "^4.2.0",
    "prettier": "3.6.2",
    "sass-embedded": "1.97.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "unplugin-auto-import": "0.18.6",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "6.4.3",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-monaco-editor-esm": "2.0.2",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.1.1"
  },
  "overrides": {
    "quill": "2.0.2"
  }
}
