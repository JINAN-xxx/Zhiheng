[Unit]
Description=FRP tunnel for Zhiheng platform
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dev
WorkingDirectory=/frp
ExecStartPre=/frp/frpc verify --config /frp/frpc.toml
ExecStart=/frp/frpc --config /frp/frpc.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
