# Copy to a new env file and generate independent secrets, or run ./deploy.sh init.
CORE_DB_NAME=zhiheng_core
CORE_DB_USER=zhiheng_core
# Required. Use a fresh raw URL-safe password: letters, digits, _ and - only.
# Do not URL-encode this value; the same raw password configures PostgreSQL.
CORE_DB_PASSWORD=
# Required. Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CORE_CREDENTIAL_KEY=
# Required. Generate independent credentials for the private Milvus object store.
# ./deploy.sh init generates both; preserve them together with the vector volumes.
CORE_VECTOR_ACCESS_KEY=
CORE_VECTOR_SECRET_KEY=
# Required. Independent root credentials for business file MinIO; never reuse vector credentials.
# ./deploy.sh init generates both; existing instances run ./deploy.sh init-minio.
# These are administrator credentials; never inject them into API or Worker.
CORE_FILES_ROOT_USER=
CORE_FILES_ROOT_PASSWORD=
# Required. API/Worker use this independent account, limited to the private business bucket.
CORE_FILES_ACCESS_KEY=
CORE_FILES_SECRET_KEY=
CORE_FILES_BUCKET=zhiheng-files
CORE_FILES_S3_ENDPOINT=http://file-objects:9000
CORE_FILES_S3_REGION=us-east-1
CORE_FILES_S3_TIMEOUT_SECONDS=30
# The S3 API is internal-only at http://file-objects:9000.
# The management console is available only on this machine by default.
CORE_FILES_CONSOLE_BIND=127.0.0.1
CORE_FILES_CONSOLE_PORT=19001
# Optional pinned MinIO image override for business storage:
# CORE_FILES_MINIO_IMAGE=milvusdb/minio:RELEASE.2024-12-18T13-15-44Z
# Optional Milvus settings (the bundled standalone service uses the default database):
CORE_MILVUS_TOKEN=
CORE_MILVUS_DATABASE=default
CORE_WEB_BIND=127.0.0.1
CORE_WEB_PORT=19080
# Keep true behind HTTPS; explicitly set false only for local HTTP development.
CORE_COOKIE_SECURE=true
# JSON array. Add the browser's exact origin, including port, for local HTTP.
CORE_ALLOWED_ORIGINS=[]
CORE_KNOWLEDGE_RERANK_BATCH_TOKENS=48000
CORE_PROVIDER_TIMEOUT_SECONDS=60
# auto: follow configured model capacity; integers explicitly override the budget.
CORE_CHAT_SUMMARY_TRIGGER_TOKENS=auto
CORE_CHAT_SUMMARY_KEEP_TOKENS=auto
CORE_CHAT_SUMMARY_INPUT_TOKENS=auto
CORE_CHAT_SUMMARY_OUTPUT_TOKENS=auto
CORE_WORKER_QUEUE=zhiheng:core:queue
# Workspace execution is optional. Enable COMPOSE_PROFILES=workspace after building the images.
# URL targets the manager bound to the private Docker bridge gateway, never the browser.
CORE_SANDBOX_URL=
CORE_SANDBOX_API_KEY=
CORE_SANDBOX_RUNTIME_IMAGE=zhiheng-workspace-runtime:0.1.0
CORE_SANDBOX_MANAGER_IMAGE=zhiheng-sandbox-manager:1.2.1
CORE_SANDBOX_EXECD_IMAGE=opensandbox/execd:release-1.2.1
CORE_SANDBOX_EGRESS_IMAGE=opensandbox/egress:release-1.2.1
CORE_SANDBOX_MANAGER_PORT=19192
CORE_SANDBOX_CPU=1
CORE_SANDBOX_MEMORY_MB=1024
CORE_SANDBOX_WORKSPACE_MB=1024
# Use DNS servers reachable from Docker bridge; replace with corporate DNS where required.
CORE_SANDBOX_DNS_SERVERS=223.5.5.5,1.1.1.1
CORE_SANDBOX_RUN_SECONDS=600
CORE_SANDBOX_READY_SECONDS=60
CORE_SANDBOX_PIP_INDEX_URL=https://pypi.org/simple
# Optional build base. Keep its Python version aligned with the execution image.
# CORE_SANDBOX_PYTHON_IMAGE=python:3.12-slim
# CORE_SANDBOX_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# Optional build overrides:
# CORE_BACKEND_IMAGE=zhiheng-core-api:0.1.0
# CORE_FRONTEND_IMAGE=zhiheng-core-web:0.1.0
# CORE_PYTHON_IMAGE=python:3.12-slim
# CORE_PIP_INDEX_URL=https://pypi.org/simple
# CORE_NODE_IMAGE=node:24-alpine
# CORE_NGINX_IMAGE=nginx:1.28-alpine

# Optional dedicated LightRAG runtime login; native PostgreSQL URL, not the migrator owner.
# Provision the role with USAGE on knowledge_graph_sdk and DML on its ten tables after migration.
# The role must have no ownership, superuser, CREATE DATABASE or schema CREATE privileges.
# Empty keeps graph unavailable while ordinary vector knowledge remains usable.
CORE_GRAPH_DATABASE_URL=
