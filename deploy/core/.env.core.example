# Copy to a new env file and generate independent secrets, or run ./deploy.sh init.
CORE_DB_NAME=zhiheng_core
CORE_DB_USER=zhiheng_core
# Required. Use a fresh raw URL-safe password: letters, digits, _ and - only.
# Do not URL-encode this value; the same raw password configures PostgreSQL.
CORE_DB_PASSWORD=
# Required. Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CORE_CREDENTIAL_KEY=
CORE_WEB_BIND=127.0.0.1
CORE_WEB_PORT=19080
# Keep true behind HTTPS; explicitly set false only for local HTTP development.
CORE_COOKIE_SECURE=true
# JSON array. Add the browser's exact origin, including port, for local HTTP.
CORE_ALLOWED_ORIGINS=[]
CORE_TOKEN_LIMIT=100000
CORE_PROVIDER_TIMEOUT_SECONDS=60
CORE_WORKER_QUEUE=zhiheng:core:queue
# Optional build overrides:
# CORE_PYTHON_IMAGE=python:3.12-slim
# CORE_PIP_INDEX_URL=https://pypi.org/simple
# CORE_NODE_IMAGE=node:24-alpine
# CORE_NGINX_IMAGE=nginx:1.28-alpine
