# 可选配置。复制为仓库根目录 .env 后执行 ./deploy.sh init。
# 数据库密码、JWT、网关密钥和 API Pepper 由脚本首次生成并持续复用。
PLATFORM_COMPOSE_PROJECT=zhiheng
PLATFORM_BIND_ADDRESS=0.0.0.0
PLATFORM_PORT=12580
PLATFORM_DATA_DIR=./data

# 后端由源码构建；前端使用版本库内的 dist。
PLATFORM_BACKEND_IMAGE=zhiheng-backend:local
PLATFORM_FRONTEND_IMAGE=nginx:latest
PLATFORM_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
MILVUS_MEMORY_LIMIT=4g
AI_PUBLIC_API_ENABLED=true
