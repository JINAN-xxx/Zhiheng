{
  "name": "zhiheng-core-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev:platform": "vite --config vite.platform.config.ts --host 127.0.0.1 --port 15190",
    "build:platform": "vite build --config vite.platform.config.ts",
    "preview:platform": "vite preview --config vite.platform.config.ts --host 127.0.0.1 --port 15190",
    "test:core": "node --experimental-strip-types --test tests/core/*.test.ts",
    "test:browser": "python tests/browser/ui_regressions.py",
    "lint:core": "eslint --max-warnings 0 eslint.config.js src/vite-env.d.ts 'src/{app,shared,modules}/**/*.{ts,vue}' tests/core/*.test.ts vite.platform.config.ts",
    "format:check": "prettier --check 'src/**/*.{ts,vue,css,scss}' tests/core/*.test.ts eslint.config.js vite.platform.config.ts .prettierrc.json tsconfig*.json package.json platform.html",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.tests.json"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@vueuse/core": "14.1.0",
    "ant-design-vue": "4.2.6",
    "dompurify": "3.4.13",
    "echarts": "6.1.0",
    "katex": "0.18.4",
    "markstream-vue": "1.1.4",
    "mermaid": "11.16.1",
    "shiki": "3.23.0",
    "stream-diffs": "0.0.2",
    "stream-markdown": "0.0.16",
    "stream-monaco": "0.0.49",
    "vue": "3.5.26",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "5.2.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "sass": "1.97.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "6.4.3",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.1.1"
  }
}
